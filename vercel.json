{
  "version": 2,
  "installCommand": "cd Lostify-Front-End && npm install && cd .. && pip install -r Lostify-Back-End/requirements.txt && cd Lostify-Back-End && python manage.py collectstatic --noinput && python manage.py migrate --noinput",
  "builds": [
    {
      "src": "Lostify-Front-End/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "Lostify-Back-End/serverless/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": "Lostify-Back-End/**"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "Lostify-Back-End/serverless/index.py" },
    { "src": "/admin/(.*)", "dest": "Lostify-Back-End/serverless/index.py" },
    { "src": "/static/(.*)", "dest": "Lostify-Back-End/serverless/index.py" },
    { "handle": "filesystem" },
    { "src": "/assets/(.*)", "dest": "Lostify-Front-End/assets/$1" },
    { "src": "/(robots\\.txt|placeholder\\.svg|favicon\\.ico|lostifylogo\\.png)", "dest": "Lostify-Front-End/$1" },
    { "src": "/(.*)", "dest": "Lostify-Front-End/index.html" }
  ]
}
