# =============================================================================
# Lostify Mobile (Flutter) — Environment Variables
# Copy to dart_defines.json for local runs (see README). Never commit real keys.
# =============================================================================

# Supabase (realtime chat & storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Django REST API
API_BASE_URL=http://127.0.0.1:8000/api/

# Android emulator (maps host localhost):
# API_BASE_URL=http://10.0.2.2:8000/api/

# Production example:
# API_BASE_URL=https://your-domain.com:9443/api/

# Google Gemini — image classification
GEMINI_API_KEY=your-gemini-api-key

# Google Maps — set in android/local.properties (see android/local.properties.example)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Run with dart-define-from-file:
#   copy dart_defines.json.example dart_defines.json
#   flutter run --dart-define-from-file=dart_defines.json
