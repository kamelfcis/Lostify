# =============================================================================
# Lostify Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# Loaded automatically by python-decouple in backend/settings.py.
# =============================================================================

# Django core
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (default: SQLite — no extra config needed for local dev)
# For PostgreSQL example:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=lostify
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# CORS & CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media & static (local development)
MEDIA_URL=/media/
STATIC_URL=/static/

# Production server example (replace with your deployment URL)
# MEDIA_URL=https://your-domain.com/media/
# ALLOWED_HOSTS=your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
