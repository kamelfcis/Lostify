# =============================================================================
# Lostify Frontend — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
#
# Vite exposes only variables prefixed with VITE_ to client code.
# =============================================================================

# Backend API base URL (include trailing path segment)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/

# Production example (Vercel same-origin):
# VITE_API_BASE_URL=/api/
