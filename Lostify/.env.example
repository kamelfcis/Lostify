# =============================================================================
# Lostify Mobile (Flutter) — Environment Variables
# Copy to dart_defines.json for local runs (see below). Never commit real keys.
# =============================================================================

# Supabase (realtime chat & storage) — required for app startup
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Django REST API
API_BASE_URL=http://127.0.0.1:8000/api/

# Android emulator (backend on host machine):
# API_BASE_URL=http://10.0.2.2:8000/api/

# Production (Vercel):
# API_BASE_URL=https://lostify-ruddy.vercel.app/api/

# Google Gemini — optional; image search uses backend POST /api/search/by-image/
# GEMINI_API_KEY=your-gemini-api-key

# Google Maps — set in android/local.properties (see android/local.properties.example)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# =============================================================================
# Production run (PowerShell)
# =============================================================================
# 1. copy dart_defines.json.example dart_defines.json
# 2. Fill SUPABASE_URL, SUPABASE_ANON_KEY, API_BASE_URL (production URL above)
# 3. copy android\local.properties.example android\local.properties
#    Set sdk.dir (from `flutter doctor`) and GOOGLE_MAPS_API_KEY
# 4. cd Lostify
# 5. flutter pub get
# 6. flutter run --dart-define-from-file=dart_defines.json
#
# Physical device: use production API_BASE_URL as-is.
# Android emulator against local backend: use http://10.0.2.2:8000/api/
