# =============================================================================
# Lostify Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# Loaded automatically by python-decouple in backend/settings.py.
# =============================================================================

# Django core
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — local dev uses SQLite (db.sqlite3) when TURSO_* vars are unset.
# Production (Vercel): set Turso credentials from https://turso.tech
# TURSO_DATABASE_URL=https://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# CORS & CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media & static (local development)
MEDIA_URL=/media/
STATIC_URL=/static/

# Image search — Google Gemini (required for POST /api/search/by-image/)
# Create key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key

# Production media — Cloudinary (required on Vercel; no persistent disk for uploads)
# Create account at https://cloudinary.com and copy CLOUDINARY_URL from dashboard
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Production (Vercel) example — replace with your deployment URL
# DEBUG=False
# ALLOWED_HOSTS=.vercel.app,your-app.vercel.app
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
